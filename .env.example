# KLIPZ configuration template. Everything is OPTIONAL: KLIPZ runs with none of this set.
#
# Where to put these (copy only the lines you want to change, never commit real secrets):
#   One file is enough: repo-root .env.local is read by BOTH the Python worker and the Next.js web app.
#   apps/web/.env.local still works for the web app and wins over the root file there.
#   [WORKER] / [WEB] / [BOTH] below only say which process uses a variable.
# Real environment variables win over files. Restart KLIPZ after editing.
# Full explanations: README.md section 5 and docs/platform-setup.md

# ─── Data location ─────────────────────────────────────────────── [BOTH]
# Default: %USERPROFILE%\.klipz  (database, media, models, secret keys, logs)
# KLIPZ_DATA_DIR=D:\klipz-data

# ─── Launcher (set as environment variables before `npm start`) ──────────────
# KLIPZ_PORT=3000            # web port (APP_URL follows it)
# KLIPZ_WORKER_PORT=8787     # worker health port (used by launcher, worker and web status check)
# KLIPZ_VENV=C:\Users\you\.klipz\venv   # Python venv location

# ─── Transcription ─────────────────────────────────────────────── [WORKER]
# WHISPER_MODEL=small        # tiny | base | small | medium | large-v3 ...
# WHISPER_DEVICE=auto        # auto | cuda | cpu   (CUDA failure falls back to CPU)
# TRANSCRIBER=auto           # auto | whisperx | faster-whisper
# HF_TOKEN=                  # only for WhisperX speaker diarization (Hugging Face token)

# ─── Clip scoring / AI captions ────────────────────────────────── [WORKER] (+ [WEB] for captions)
# Free default: offline heuristic scorer. Options below are OPTIONAL.
# (All of this can also be set on the AI page in the app; values here win and show as locked there.)
# LLM_PROVIDER=auto          # auto | anthropic | openai | ollama | none
# KLIPZ_SMART_EDIT=1         # 0 = no automatic jump cuts / punch-ins / hook card on new clips
#
# PAID: Anthropic API. Enables Claude clip scoring (worker) and AI captions (web).
# Put the key in BOTH files if you want both features.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
#
# Any OpenAI-compatible chat API (OpenAI, OpenRouter, Groq, LM Studio, llama.cpp server):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
#
# FREE local alternative for scoring: Ollama (https://ollama.com), model must already be pulled.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# ─── Optional paid extras ──────────────────────────────────────── [WORKER]
# PAID: ElevenLabs text-to-speech voiceover. Off without a key.
# ELEVENLABS_API_KEY=

# ─── Storage / rendering / models ──────────────────────────────── [WORKER]
# SOURCE_RETENTION_DAYS=30   # days to keep source video/audio before cleanup
# KLIPZ_RENDER_CONCURRENCY=  # browser tabs per render; lower (e.g. 2) if renders run out of memory
# KLIPZ_MODEL_DOWNLOAD=1     # 0 = never download the MediaPipe face model
# KLIPZ_MODEL_DIR=           # default <data dir>\models
# KLIPZ_POLL_INTERVAL=1.0    # seconds between job polls
# KLIPZ_STALE_SECONDS=120    # reclaim a running job after this long without heartbeat

# ─── Web app basics ────────────────────────────────────────────── [WEB]
# Public base URL; builds OAuth redirect URIs (http://localhost:3000/api/oauth/<provider>/callback)
# and the allowed Host header. Set to your HTTPS tunnel URL when a platform (TikTok) needs HTTPS.
# APP_URL=http://localhost:3000
# FFMPEG_PATH=               # use another ffmpeg than the bundled one

# Sandbox posting: fake accounts and fake posts, nothing is sent to any platform.
# KLIPZ_PUBLISH_MOCK=1

# Token encryption key / OAuth state secret. Generated automatically into
# <data dir>\secret.key and state.key when unset. Only set to manage them yourself;
# losing the encryption key means reconnecting every account.
# TOKEN_ENCRYPTION_KEY=
# OAUTH_STATE_SECRET=

# ─── Platform developer apps ───────────────────────────────────── [WEB]
# Create your own apps (free). Redirect URIs are shown on the Accounts page.
# YouTube (Google Cloud, YouTube Data API v3; app in Testing mode: uploads private, tokens expire in 7 days)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# TikTok (needs HTTPS redirect; unaudited app posts private only)
# TIKTOK_CLIENT_ID=          # the "client key"
# TIKTOK_CLIENT_SECRET=
# TIKTOK_SOURCE=             # leave unset (file upload). "pull" = PULL_FROM_URL, needs public verified URL
# TIKTOK_AUDITED=true        # set once your TikTok app passed audit (removes the "forced private" warning)

# KLIPZ_UPLOAD_MODE=buffer   # Instagram/Facebook/aggregator uploads as one in-memory buffer instead of streaming

# Meta: ONE app for Instagram Reels and Facebook Page Reels
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=        # override Graph API version (adapter default v27.0)
# META_CONFIG_ID=            # Facebook Login for Business configuration id

# X: posting video needs a PAID tier or pay-per-use credits
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# LinkedIn: products "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=          # Linkedin-Version header YYYYMM (adapter default 202610)
# LINKEDIN_EXTRA_SCOPES=     # only scopes LinkedIn approved for you

# Max status polls per upload attempt for asynchronous platforms (adapter default if unset)
# KLIPZ_POLL_MAX_ATTEMPTS=

# ─── Aggregator fallback (PAID third-party service) ────────────── [WEB]
# Routes the listed platforms through Upload-Post or Ayrshare instead of your own apps.
# AGGREGATOR_KIND=upload-post      # upload-post | ayrshare
# AGGREGATOR_API_KEY=
# AGGREGATOR_PROVIDERS=tiktok,instagram   # youtube tiktok instagram facebook x linkedin
# AGGREGATOR_PROFILE_KEY=
# AGGREGATOR_BASE_URL=
