{
  "name": "klipz",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @klipz/web",
    "start": "node scripts/start.mjs",
    "klipz": "node scripts/start.mjs",
    "build": "npm run build -w @klipz/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:worker": "node scripts/worker.mjs test",
    "worker": "node scripts/worker.mjs",
    "seed": "node scripts/seed.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "e2e": "node scripts/e2e.mjs",
    "desktop:stage": "node scripts/build-desktop.mjs --stage-only",
    "desktop:installer": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
